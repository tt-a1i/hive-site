  },
  {
    name: 'Grok Build',
    href: 'https://x.ai',
    path: 'M9.27 15.29l7.978-5.897c.391-.29.95-.177 1.137.272.98 2.369.542 5.215-1.41 7.169-1.951 1.954-4.667 2.382-7.149 1.406l-2.711 1.257c3.889 2.661 8.611 2.003 11.562-.953 2.341-2.344 3.066-5.539 2.388-8.42l.006.007c-.983-4.232.242-5.924 2.75-9.383.06-.082.12-.164.179-.248l-3.301 3.305v-.01L9.267 15.292M7.623 16.723c-2.792-2.67-2.31-6.801.071-9.184 1.761-1.763 4.647-2.483 7.166-1.425l2.705-1.25a7.808 7.808 0 00-1.829-1A8.975 8.975 0 005.984 5.83c-2.533 2.536-3.33 6.436-1.962 9.764 1.022 2.487-.653 4.246-2.34 6.022-.599.63-1.199 1.259-1.682 1.925l7.62-6.815',
  },
  { name: 'Hermes', href: 'https://hermes-agent.nousresearch.com', img: '/logos/hermes.svg', imgSize: 'size-[62%]' },
  { name: 'Qwen Code', href: 'https://github.com/QwenLM/qwen-code', img: '/logos/qwen.png' },
]

const baseDelay = 0.2
const step = 0.04
---

<section class="relative isolate py-24 sm:py-32">
  <div class="pointer-events-none absolute -top-20 left-1/2 size-[1000px] -z-10 -translate-x-1/2 rounded-full blur-[140px]" style="background: radial-gradient(circle, var(--color-cool-wash), transparent 60%);"></div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal max-w-2xl" style="animation-delay:0.05s">
      <p class="type-kicker flex items-center gap-3 text-[var(--color-accent)]"><span class="h-px w-6 bg-current opacity-55" aria-hidden="true"></span>{t.label}</p>
      <h2 class="type-h2 mt-4 text-balance text-[var(--color-text)]">{t.heading}</h2>
      <p class="mt-4 max-w-xl text-[15.5px] leading-[1.78] text-[var(--color-text-muted)]">{t.sub}</p>
    </div>

    <ul class="mt-14 flex flex-wrap justify-center gap-x-3 gap-y-10">
      {tiles.map((tile, i) => (
        <li class="reveal w-24" style={`animation-delay:${baseDelay + i * step}s`}>
          <a href={tile.href} target="_blank" rel="noopener" class="group block">
            <div class="flex aspect-square items-center justify-center rounded-xl border border-[var(--color-border)] bg-[var(--color-tile)] shadow-[inset_0_1px_0_rgba(255,255,255,0.07)] transition-all duration-200 ease-out group-hover:-translate-y-0.5 group-hover:border-[var(--color-accent)]/45 group-active:translate-y-0 group-active:duration-75">
              {tile.img ? (
                <img src={tile.img} alt="" aria-hidden="true" class={tile.imgSize ?? 'size-[60%]'} loading="lazy" decoding="async" />
              ) : (
                <svg viewBox={tile.viewBox ?? '0 0 24 24'} fill="#f2efe9" fill-rule="evenodd" class="size-[55%]" aria-hidden="true" focusable="false">
                  <path d={tile.path} />
                </svg>
              )}
            </div>
            <p class="mt-3.5 whitespace-nowrap text-center text-[12px] font-medium tracking-tight text-[var(--color-text-muted)] transition-colors duration-150 group-hover:text-[var(--color-text)]">{tile.name}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
