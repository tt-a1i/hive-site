---
import type { Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props

const t = lang === 'zh'
  ? {
      label: '阵容',
      heading: '已经在巢里的，和能加入的。',
      sub: '九个预设开箱即用——而那只是开始。你电脑上能跑的任何 Agent，Hive 里都能跑：用你已经登录好的 CLI 就行，Hive 自己不要账号、不要 key。',
    }
  : {
      label: 'The lineup',
      heading: "Who's already in the hive.",
      sub: "Nine presets out of the box — and that's just the start. Any agent on your laptop runs here too: your CLIs bring their own logins. Hive itself asks for no account, no key.",
    }

interface Tile {
  name: string
  href: string
  img?: string
  imgSize?: string
  path?: string
  viewBox?: string
}
const tiles: Tile[] = [
  { name: 'Claude Code', href: 'https://claude.com/code', img: '/logos/claude-code.png' },
  {
    name: 'Codex CLI',
    href: 'https://github.com/openai/codex',
