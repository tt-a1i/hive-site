  },
  { name: 'Gemini CLI', href: 'https://github.com/google-gemini/gemini-cli', img: '/logos/gemini.png' },
  {
    name: 'OpenCode',
    href: 'https://opencode.ai',
    viewBox: '0 0 512 512',
    path: 'M384 416H128V96H384V416ZM320 160H192V352H320V160ZM320 224V352H192V224H320Z',
  },
  {
