---
import type { Lang } from '../i18n'
import SectionHeading from './SectionHeading.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props

/* The everyday pain Hive removes: you relaying between agent windows.
   Left is the chore list (crossed out); right is the same afternoon as
   four lines of team protocol, in the pattern cards' terminal style. */
const t = lang === 'zh'
  ? {
      kicker: '为什么要 Hive',
      heading: '你不该是 Agent 之间的剪贴板。',
      sub: '一个 Agent 写完，你复制输出，贴给另一个去审；审完再把意见贴回来，顺手再提醒一遍项目约定。窗口多开几个，你就成了全职传话员。',
      beforeLabel: '没有 Hive',
      before: [
        '复制 Claude 的 diff，贴给 Codex',
        '把 Codex 的意见原样贴回 Claude',
        '切到第三个终端，看测试跑完没',
        '第四次解释“测试放 tests/ 下”',
      ],
      afterLabel: '有 Hive',
      after: [
        { d: 'out', s: 'team send codex "审 claude 的 diff"' },
        { d: 'in', s: 'codex report: 2 处要改，已标位置' },
        { d: 'out', s: 'team send claude "按 codex 的意见改"' },
        { d: 'in', s: 'claude report: 改完了，测试全绿' },
      ],
      afterNote: '项目约定存进团队记忆，每次派单自动带上；谁在干活、谁闲着，一屏看完。',
    }
  : {
      kicker: 'Why Hive',
      heading: 'Stop being the clipboard between your agents.',
      sub: 'One agent finishes; you copy its output into another for review, then paste the notes back, and restate the project conventions while you are at it. Open a few more windows and relaying becomes your full-time job.',
      beforeLabel: 'Without Hive',
      before: [
        "Copy Claude's diff, paste it into Codex",
        "Paste Codex's notes back into Claude",
        'Tab to a third terminal: are the tests done?',
        'Explain “tests go in tests/” for the fourth time',
      ],
      afterLabel: 'With Hive',
      after: [
        { d: 'out', s: 'team send codex "review claude\'s diff"' },
        { d: 'in', s: 'codex report: 2 fixes needed, lines marked' },
        { d: 'out', s: 'team send claude "apply codex\'s notes"' },
        { d: 'in', s: 'claude report: done, tests green' },
      ],
      afterNote: "Conventions live in team memory and ride along with every dispatch. Who's busy and who's free: one screen.",
    }
---

<section class="relative isolate py-16 sm:py-24">

  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading kicker={t.kicker} heading={t.heading} sub={t.sub} class="reveal" />

    <div class="mt-12 grid gap-5 lg:grid-cols-2">
      <div class="reveal rounded-2xl border border-[var(--color-border)] bg-white/80 p-7 backdrop-blur-sm sm:p-8" style="animation-delay:0.1s">
        <p class="type-kicker text-[var(--color-text-faint)]">{t.beforeLabel}</p>
        <ul class="mt-5 space-y-3.5">
          {t.before.map((item) => (
            <li class="flex items-start gap-3 text-[15px] leading-snug text-[var(--color-text-muted)]">
              <span class="mt-[2px] inline-flex size-4 shrink-0 items-center justify-center rounded-full bg-[var(--color-surface-2)] text-[9px] text-[var(--color-text-faint)]" aria-hidden="true">✕</span>
              <span class="line-through decoration-[var(--color-warm)] decoration-2">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="reveal flex flex-col rounded-2xl border border-[var(--color-border)] bg-[var(--color-tile)] p-7 shadow-[0_30px_80px_-30px_rgba(15,23,42,0.3)] sm:p-8" style="animation-delay:0.18s">
        <p class="type-kicker text-[var(--color-warm)]">{t.afterLabel}</p>
        <ol class="mt-5 space-y-3 font-mono text-[12.5px] leading-[1.6] sm:text-[13px]">
          {t.after.map((line) => (
            <li class="flex gap-2.5">
              <span class={line.d === 'out' ? 'text-[#7da7ff]' : 'text-[var(--color-warm)]'} aria-hidden="true">{line.d === 'out' ? '$' : '←'}</span>
              <span class={line.d === 'out' ? 'text-[#f2efe9]' : 'text-[var(--color-warm)]'}>{line.s}</span>
            </li>
          ))}
        </ol>
        <p class="mt-6 border-t border-white/10 pt-5 text-[13.5px] leading-relaxed text-white/60 lg:mt-auto">{t.afterNote}</p>
      </div>
    </div>
  </div>
</section>
