---
import type { Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props

const t = lang === 'zh'
  ? {
      headline1: '在你的浏览器里，',
      headline2: '造一座 Agent 蜂巢。',
      subhead: '让 Claude 写，Codex 审，Gemini 测。',
      mechanic:
        'Hive 把你电脑上已经装好的 CLI Agent 编成一支队伍：Orchestrator 拆活、派单，成员们在浏览器里的真终端各自开工，干完自己交回。全部跑在你本机。',
      copy: '复制',
      copied: '已复制',
      viewSource: '先读源码',
    }
  : {
      headline1: 'A hive of agents',
      headline2: 'right in your browser.',
      subhead: 'Claude writes. Codex reviews. Gemini tests.',
      mechanic:
        "Hive turns the CLI agents already on your machine into a team. The orchestrator splits the work and hands it out; each member runs in a real terminal in your browser and reports back when it's done. All on your machine.",
      copy: 'Copy',
      copied: 'Copied',
      viewSource: 'Read the source first',
    }
---

<section class="relative isolate overflow-hidden pt-32 pb-16 sm:pt-44 sm:pb-20">
  {/* Watercolor hero background — cool blue → cream → warm peach.
     Mask fades the painting into the page bg at the bottom so it doesn't
     hard-cut into the screenshot section below. */}
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background-image:url('/hero-bg.webp'); background-size:cover; background-position:50% 30%; mask-image:linear-gradient(180deg, black 0%, black 55%, transparent 100%); -webkit-mask-image:linear-gradient(180deg, black 0%, black 55%, transparent 100%);"
  ></div>

  <div class="mx-auto max-w-6xl px-6">
    <h1 class="type-display max-w-5xl">
      <span class="block text-[var(--color-text)]">{t.headline1}</span>
      <span class="block text-[var(--color-accent)] sm:pl-[1.5em]">{t.headline2}</span>
    </h1>

    <p
      class="type-subhead reveal mt-6 max-w-2xl text-balance text-[var(--color-text-muted)]"
      style="animation-delay:0.28s"
    >
      {/* One clause per unbreakable run: "Codex 审，" never splits. */}
      {t.subhead.split(/(?<=[，。.])\s*/).map((clause) => <><span class="inline-block">{clause}</span>{lang === 'en' ? ' ' : ''}</>)}
    </p>

    <p
      class="reveal mt-5 max-w-xl text-[15px] leading-[1.75] text-[var(--color-text-muted)] [text-wrap:pretty]"
      style="animation-delay:0.36s"
    >
      {t.mechanic}
    </p>

    <div class="reveal mt-10 flex flex-wrap items-center gap-3" style="animation-delay:0.46s">
      {/* Primary action is the install itself — one click, one paste. */}
      <button
        type="button"
        class="group inline-flex items-center gap-3 rounded-full bg-[var(--color-accent)] py-2.5 pr-2.5 pl-5 font-mono text-[13px] text-white shadow-[0_8px_24px_-8px_rgba(37,99,235,0.45)] transition-all duration-200 ease-out hover:-translate-y-px hover:bg-[var(--color-accent-hi)] hover:shadow-[0_12px_32px_-8px_rgba(37,99,235,0.55)] active:translate-y-0 active:duration-75"
        data-copy-text="npm i -g @tt-a1i/hive"
        data-copied-label={t.copied}
      >
        <span class="select-none text-white/60">$</span>
        <span>npm i -g @tt-a1i/hive</span>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white/20 px-3 py-1 font-sans text-[11.5px] font-semibold transition-colors group-hover:bg-white/30">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" focusable="false"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
          <span data-copy-label>{t.copy}</span>
        </span>
      </button>
      <a
        href="https://github.com/tt-a1i/hive"
        class="group inline-flex items-center gap-2 rounded-full border border-[var(--color-border-hi)] bg-white/70 px-6 py-3 text-[13.5px] font-semibold text-[var(--color-text)] backdrop-blur-sm transition-colors duration-150 ease-out hover:border-[var(--color-text-muted)] hover:bg-white"
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.34c-2.22.48-2.69-1.07-2.69-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.23 1.88.87 2.34.66.07-.52.28-.87.5-1.07-1.77-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"/>
        </svg>
        {t.viewSource}
      </a>
    </div>

  </div>
</section>
