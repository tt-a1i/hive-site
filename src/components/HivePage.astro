---
import { getImage } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import Nav from './Nav.astro'
import Hero from './Hero.astro'
import SectionHeading from './SectionHeading.astro'
import FeatureGrid from './FeatureGrid.astro'
import RemoteBand from './RemoteBand.astro'
import CliGrid from './CliGrid.astro'
import Workbench from './Workbench.astro'
import Clipboard from './Clipboard.astro'
import hiveUi from '../assets/screenshots/hive-ui.png'
import type { Lang } from '../i18n'

/* Pattern-card terminal vignettes: out = a dispatch leaving the
   orchestrator ($, cool blue), in = a report coming back (←, warm peach).
   Same cool→warm direction as the hero watercolor. */
interface PatternLine {
  dir: 'out' | 'in'
  cmd: string
  arg: string
}

interface Props {
  lang: Lang
}
const { lang } = Astro.props

/* Build-time fetch — npm registry + downloads. These are the most reliable
   "this is alive" signals available. If a fetch fails we omit the line
   entirely rather than advertise a stale hardcoded version. */
const fetchJson = async (url: string) => {
  try {
    const r = await fetch(url, {
      headers: { accept: 'application/json' },
      signal: AbortSignal.timeout(5000),
    })
    if (!r.ok) return null
    return await r.json()
  } catch {
    return null
  }
}

const npmPkg = await fetchJson('https://registry.npmjs.org/@tt-a1i/hive')
const npmLatest =
  (npmPkg && (npmPkg['dist-tags'] as Record<string, string> | undefined)?.latest) ?? null
const npmTimes = (npmPkg && (npmPkg.time as Record<string, string> | undefined)) ?? null
const npmPublishedISO = (npmLatest && npmTimes?.[npmLatest]) ?? null
/* Absolute date — a relative "published yesterday" fossilizes in static
   HTML and turns false a day after the deploy. */
const npmPublishedDate = npmPublishedISO ? npmPublishedISO.slice(0, 10) : null

const dlData = await fetchJson(
  'https://api.npmjs.org/downloads/point/last-week/@tt-a1i/hive'
)
const weeklyDownloads = (dlData?.downloads as number | undefined) ?? null

/* The hero area shows a scripted replay of the protocol; the real,
   unretouched workbench screenshot is the video poster further down. */
const SHOT_WIDTHS = [768, 1280, 1920]
const shotAvif = await getImage({ src: hiveUi, format: 'avif', widths: SHOT_WIDTHS })
const shotWebp = await getImage({ src: hiveUi, format: 'webp', widths: SHOT_WIDTHS })
const shotFallback = await getImage({ src: hiveUi, format: 'webp', width: 1280 })
const shotSizes = '(min-width: 1104px) 1024px, 92vw'

const t = lang === 'zh'
  ? {
      shotAlt:
        'Hive 工作台：浏览器里的 orchestrator 给多个 CLI worker（Claude Code、Codex、Gemini 等）派活的协作截图',
      video: {
        label: '演示视频',
        heading: '七分钟，一刀不剪。',
        sub: '从启动 Orchestrator、派活、汇报到换角色分工，完整走一遍真实流程。',
        play: '播放演示',
        meta: '07:21 · Bilibili',
        note: '视频原片：<a href="https://www.bilibili.com/video/BV1UHLp6nEQR" target="_blank" rel="noopener" class="underline-offset-2 transition-colors hover:text-[var(--color-text)] hover:underline">在 Bilibili 打开</a>',
      },
      patterns: {
        label: '三种分工',
        heading: '蜂巢里没有英雄。',
        sub: '没有哪个 Agent 包揽全程。作者之外有人审、有人测，问题才藏不住。',
        legendOut: '派出去',
        legendIn: '交回来',
        cards: [
          {
            title: '写 + 审',
            body: 'Claude 写，Codex 审。作者自查总会放过自己的习惯性错误，换一家模型来挑，狠得多。你只看最后那版 diff。',
            lines: [
              { dir: 'out', cmd: 'team send claude', arg: '"写：给设置页加暗色模式"' },
              { dir: 'out', cmd: 'team send codex', arg: '"审：挑这版 diff 的毛病"' },
              { dir: 'in', cmd: 'codex report:', arg: '2 处边界问题，得再改一轮' },
            ] as PatternLine[],
          },
          {
            title: '测 + 修',
            body: 'Gemini 跑测试，红了派给 Claude 修，修完再跑。红绿循环在巢里自己转，什么时候收工由你定。',
            lines: [
              { dir: 'out', cmd: 'team send gemini', arg: '"写测试，全量跑一遍"' },
              { dir: 'in', cmd: 'gemini report:', arg: '3 条红' },
              { dir: 'out', cmd: 'team send claude', arg: '"修掉这 3 条红"' },
            ] as PatternLine[],
          },
          {
            title: '不止写代码',
            body: '研究员核查来源，译者出英文版，编辑统一口径。起个角色名、写几句职责，就能派活。',
            lines: [
              { dir: 'out', cmd: 'team send researcher', arg: '"核查引用的 5 个来源"' },
              { dir: 'out', cmd: 'team send translator', arg: '"把结论翻成英文"' },
              { dir: 'in', cmd: 'researcher report:', arg: '两条站不住，已附出处' },
            ] as PatternLine[],
          },
        ],
      },
      install: {
        kicker: '安装',
        heading: '两条命令，造一座蜂巢。',
        copy: '复制',
        copied: '已复制',
        openHint: '# 打开它打印的本机地址，通常是 http://127.0.0.1:3000',
        published: (d: string) => `发布于 ${d}`,
        downloads: (n: string) => `周下载 ${n}`,
        demo: '还没装任何 Agent CLI？启动后在向导里点 <strong>Try Demo</strong>，先看一个演示蜂巢跑起来，再决定装不装真的。',
        trust: '只监听 127.0.0.1 · 代码不出本机 · BSL 1.1 · Node ≥ 22 · macOS / Linux / Windows',
      },
      manifesto: ['一个 Agent，等你的下一条指令。', '一座蜂巢，朝你给的方向飞。'],
      footerNote: 'Hive · 2026',
      builtBy: '由 <a href="https://github.com/tt-a1i" target="_blank" rel="noopener" class="underline-offset-2 transition-colors hover:text-[var(--color-text)] hover:underline">@tt-a1i</a> 一人维护 · Node ≥ 22',
      footerTagline: '一座属于你的 Agent 蜂巢。本地运行，源码可见。',
      footerColProduct: '产品',
      footerColAbout: '项目',
      footerLinkChangelog: '更新日志',
      footerLinkLicense: '许可证 · BSL 1.1',
      footerLinkSecurity: '安全',
      footerLinkIssues: '反馈',
    }
  : {
      shotAlt:
        'Hive workbench: an orchestrator dispatching tasks to Claude Code, Codex and Gemini worker terminals in the browser',
      video: {
        label: 'Demo video',
        heading: 'Seven minutes. No cuts.',
        sub: 'Orchestrator up, work dispatched, reports in, roles switched — the real flow, unedited. Narration is in Chinese; the terminals speak for themselves.',
        play: 'Play the demo',
        meta: '07:21 · Bilibili',
        note: 'Source video: <a href="https://www.bilibili.com/video/BV1UHLp6nEQR" target="_blank" rel="noopener" class="underline-offset-2 transition-colors hover:text-[var(--color-text)] hover:underline">open on Bilibili</a>',
      },
      patterns: {
        label: 'Three ways to split',
        heading: 'No hero in the hive.',
        sub: 'No single agent carries the whole job. When someone other than the author reviews and tests, problems have nowhere to hide.',
        legendOut: 'goes out',
        legendIn: 'comes back',
        cards: [
          {
            title: 'Write + review',
            body: 'Claude writes, Codex reviews. Authors let their own habits slide; a different vendor picking at the diff is far less forgiving. You read the final version.',
            lines: [
              { dir: 'out', cmd: 'team send claude', arg: '"implement dark mode"' },
              { dir: 'out', cmd: 'team send codex', arg: '"review claude\'s diff"' },
              { dir: 'in', cmd: 'codex report:', arg: '2 edge cases to fix' },
            ] as PatternLine[],
          },
          {
            title: 'Test + fix',
            body: 'Gemini runs the tests, reds go to Claude, then the suite runs again. The loop spins inside the hive; you decide when green means done.',
            lines: [
              { dir: 'out', cmd: 'team send gemini', arg: '"write + run tests"' },
              { dir: 'in', cmd: 'gemini report:', arg: '3 failures' },
              { dir: 'out', cmd: 'team send claude', arg: '"fix those 3 reds"' },
            ] as PatternLine[],
          },
          {
            title: 'Beyond code',
            body: 'Researcher, translator, screenwriter, debate partner — name the role and let the orchestrator run the rota.',
            lines: [
              { dir: 'out', cmd: 'team send researcher', arg: '"vet 5 sources"' },
              { dir: 'out', cmd: 'team send translator', arg: '"make it English"' },
              { dir: 'in', cmd: 'researcher report:', arg: "2 don't hold up" },
            ] as PatternLine[],
          },
        ],
      },
      install: {
        kicker: 'Install',
        heading: 'Two commands to a hive.',
        copy: 'Copy',
        copied: 'Copied',
        openHint: '# open the URL it prints — usually http://127.0.0.1:3000',
        published: (d: string) => `published ${d}`,
        downloads: (n: string) => `${n} weekly downloads`,
        demo: 'No agent CLIs installed yet? Hit <strong>Try Demo</strong> in the first-run wizard — watch a demo hive run before you install a real one.',
        trust: 'Binds to 127.0.0.1 · your code stays home · BSL 1.1 · Node ≥ 22 · macOS / Linux / Windows',
      },
      manifesto: ['One agent waits for your next word.', 'A hive flies where you point.'],
      footerNote: 'Hive · 2026',
      builtBy: 'Solo-built by <a href="https://github.com/tt-a1i" target="_blank" rel="noopener" class="underline-offset-2 transition-colors hover:text-[var(--color-text)] hover:underline">@tt-a1i</a> · Node ≥ 22',
      footerTagline: 'A hive of agents, on your laptop. Local, source-available.',
      footerColProduct: 'Product',
      footerColAbout: 'Project',
      footerLinkChangelog: 'Changelog',
      footerLinkLicense: 'License · BSL 1.1',
      footerLinkSecurity: 'Security',
      footerLinkIssues: 'Issues',
    }

const videoEmbedSrc =
  'https://player.bilibili.com/player.html?bvid=BV1UHLp6nEQR&page=1&as_wide=1&high_quality=1&danmaku=0&autoplay=1'
---

<Layout lang={lang} npmVersion={npmLatest}>
  <Nav lang={lang} />

  <main class="overflow-x-clip">
    <Hero lang={lang} />

    {/* ─── The product, running — a scripted replay of the real team
        protocol where the static screenshot used to be. ───────── */}
    <section class="relative isolate pb-16 sm:pb-20">
      <div class="reveal mx-auto max-w-[1320px] px-4 sm:px-6" style="animation-delay:0.15s">
        <Workbench lang={lang} />
      </div>
    </section>

    <Clipboard lang={lang} />

    {/* ─── Demo video — click-to-load facade, no third-party JS until asked ─ */}
    <section class="relative isolate overflow-hidden py-16 sm:py-20">
      <div class="mx-auto max-w-6xl px-6">
        <SectionHeading kicker={t.video.label} heading={t.video.heading} sub={t.video.sub} class="reveal" />
        <div class="reveal mt-12 max-w-5xl overflow-hidden rounded-2xl border border-[var(--color-border)] shadow-[0_30px_80px_-30px_rgba(15,23,42,0.25)]" style="animation-delay:0.15s">
          <div class="relative bg-[var(--color-tile)]" style="aspect-ratio: 16 / 9;" data-video-facade data-src={videoEmbedSrc} data-title={lang === 'zh' ? 'Hive 演示视频' : 'Hive demo video'}>
            {/* The real workbench as the poster, dimmed behind the play button. */}
            <picture>
              <source type="image/avif" srcset={shotAvif.srcSet.attribute} sizes={shotSizes} />
              <source type="image/webp" srcset={shotWebp.srcSet.attribute} sizes={shotSizes} />
              <img src={shotFallback.src} width={hiveUi.width} height={hiveUi.height} alt={t.shotAlt} loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover object-left-top opacity-45" />
            </picture>
            <div class="absolute inset-0 bg-gradient-to-b from-[#0e1117]/20 to-[#0e1117]/70"></div>
            <button
              type="button"
              class="group absolute inset-0 flex size-full cursor-pointer flex-col items-center justify-center gap-5"
              data-video-play
            >
              <span class="flex size-16 items-center justify-center rounded-full bg-white/10 ring-1 ring-white/20 backdrop-blur transition-all duration-200 ease-out group-hover:scale-105 group-hover:bg-[var(--color-accent)] sm:size-20">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="white" aria-hidden="true" focusable="false">
                  <path d="M8 5.5v13l11-6.5z"/>
                </svg>
              </span>
              <span class="text-[13.5px] font-medium text-white/90">{t.video.play}</span>
              <span class="font-mono text-[11px] tracking-[0.08em] text-white/50">{t.video.meta}</span>
            </button>
          </div>
        </div>
        <p class="mt-6 max-w-5xl text-center text-[13px] text-[var(--color-text-muted)]" set:html={t.video.note} />
      </div>
    </section>

    {/* ─── Use-case patterns — three concrete "what could I do with this?" cards ─ */}
    <section class="relative isolate py-16 sm:py-24">
      {/* Soft watercolor echoes — peach in the upper-right, sky-blue in the lower-left */}
      <div class="pointer-events-none absolute -top-32 -right-40 size-[700px] -z-10 rounded-full blur-[120px]" style="background: radial-gradient(circle, var(--color-warm-soft), transparent 65%);"></div>
      <div class="pointer-events-none absolute -bottom-40 -left-40 size-[600px] -z-10 rounded-full blur-[120px]" style="background: radial-gradient(circle, var(--color-cool-wash), transparent 65%);"></div>

      <div class="mx-auto max-w-6xl px-6">
        <SectionHeading kicker={t.patterns.label} heading={t.patterns.heading} sub={t.patterns.sub} class="reveal" style="animation-delay:0.05s" />

        {/* Each pattern is a tiny team-protocol transcript: dispatches leave
            in cool blue, reports return in warm peach — the hero watercolor's
            cool→warm read, applied to the product's own grammar. */}
        <p class="reveal mt-8 flex items-center gap-7 font-mono text-[12px] text-[var(--color-text-muted)]" style="animation-delay:0.1s">
          <span class="flex items-baseline gap-2.5"><span class="text-[var(--color-accent)]" aria-hidden="true">$</span>{t.patterns.legendOut}</span>
          <span class="flex items-baseline gap-2.5"><span class="text-[#b45309]" aria-hidden="true">←</span>{t.patterns.legendIn}</span>
        </p>

        <ul class="mt-8 grid gap-x-5 gap-y-12 lg:grid-cols-3">
          {t.patterns.cards.map((card, i) => (
            <li class="reveal flex max-w-xl flex-col lg:max-w-none" style={`animation-delay:${0.15 + i * 0.1}s`}>
              <div class="flex-1 rounded-2xl border border-[var(--color-border)] bg-[var(--color-tile)] p-5 shadow-[inset_0_1px_0_rgba(255,255,255,0.07)] sm:p-6">
                <ol class="space-y-3 font-mono text-[12px] leading-[1.7]">
                  {card.lines.map((line) => (
                    <li class="flex gap-2.5">
                      <span class={`select-none ${line.dir === 'out' ? 'text-[#7da7ff]' : 'text-[var(--color-warm)]'}`} aria-hidden="true">{line.dir === 'out' ? '$' : '←'}</span>
                      {line.dir === 'out' ? (
                        <span class="text-[#f2efe9]">{line.cmd} <span class="text-white/60">{line.arg}</span></span>
                      ) : (
                        <span class="text-[var(--color-warm)]">{line.cmd} <span class="text-white/70">{line.arg}</span></span>
                      )}
                    </li>
                  ))}
                </ol>
              </div>
              <h3 class="mt-5 text-[17px] font-semibold leading-snug text-[var(--color-text)]">{card.title}</h3>
              <p class="mt-2 text-[14px] leading-[1.7] text-[var(--color-text-muted)]">{card.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ─── Capabilities beyond dispatch — auto-staff, workflows, memory,
        tasks.md, resume, marketplace. All public-README facts. ───── */}
    <FeatureGrid lang={lang} />

    {/* ─── Supported CLIs grid ──────────────────────────────────── */}
    <CliGrid lang={lang} />

    {/* ─── Remote access — the one dark band: phone reach, local trust ─ */}
    <RemoteBand lang={lang} />

    {/* ─── Install — the conversion moment, with a proper heading ── */}
    <section id="install" class="relative isolate py-24 sm:py-32">
      {/* Watercolor texture echo so the painted quality carries into the
          bottom half of the page, plus the soft amber halo. */}
      <div
        class="pointer-events-none absolute inset-0 -z-10 opacity-[0.07]"
        style="background-image:url('/hero-bg.webp'); background-size:cover; background-position:50% 60%; mask-image:radial-gradient(ellipse 80% 70% at 50% 50%, black, transparent 75%); -webkit-mask-image:radial-gradient(ellipse 80% 70% at 50% 50%, black, transparent 75%);"
      ></div>
      <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 size-[900px] -translate-x-1/2 -translate-y-1/2 rounded-full blur-[120px]" style="background: radial-gradient(circle, var(--color-warm-soft), transparent 60%);"></div>

      <div class="mx-auto max-w-3xl px-6">
        <SectionHeading kicker={t.install.kicker} heading={t.install.heading} class="reveal" />

        <div class="reveal mt-10 rounded-3xl border border-[var(--color-border)] bg-white p-8 shadow-[0_20px_60px_-20px_rgba(15,23,42,0.12)] sm:p-10" style="animation-delay:0.1s">
          <div class="relative mt-0 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-2)] p-5 font-mono text-[13px] leading-[1.95]">
            <button
              type="button"
              class="absolute right-3 top-3 inline-flex items-center gap-1.5 rounded-md border border-[var(--color-border)] bg-white px-2.5 py-1.5 font-mono text-[11px] text-[var(--color-text-muted)] transition-colors duration-150 ease-out hover:border-[var(--color-accent)]/40 hover:text-[var(--color-text)]"
              data-copy-text={'npm i -g @tt-a1i/hive\nhive'}
              data-copied-label={t.install.copied}
            >
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                <rect x="9" y="9" width="11" height="11" rx="2"/>
                <path d="M5 15V5a2 2 0 0 1 2-2h10"/>
              </svg>
              <span data-copy-label>{t.install.copy}</span>
            </button>
            <div><span class="select-none text-[var(--color-accent)]">$</span> <span class="text-[var(--color-text)]">npm i -g @tt-a1i/hive</span></div>
            <div><span class="select-none text-[var(--color-accent)]">$</span> <span class="text-[var(--color-text)]">hive</span></div>
            <div class="text-[var(--color-text-faint)]">{t.install.openHint}</div>
          </div>

          {(npmLatest || weeklyDownloads !== null) && (
            <p class="mt-5 font-mono text-[11px] tracking-[0.06em] text-[var(--color-text-faint)]">
              {npmLatest && <span class="text-[var(--color-text-muted)]">v{npmLatest}</span>}
              {npmPublishedDate && <><span class="mx-2 opacity-50">·</span>{t.install.published(npmPublishedDate)}</>}
              {weeklyDownloads !== null && <><span class="mx-2 opacity-50">·</span>{t.install.downloads(weeklyDownloads.toLocaleString('en-US'))}</>}
            </p>
          )}

          <p class="mt-5 text-[13.5px] leading-relaxed text-[var(--color-text-muted)] [&_strong]:font-semibold [&_strong]:text-[var(--color-text)]" set:html={t.install.demo} />

          <p class="mt-6 border-t border-[var(--color-border)]/70 pt-5 font-mono text-[11px] leading-relaxed text-[var(--color-text-faint)]">
            {t.install.trust}
          </p>
        </div>

        <p class="reveal mt-6 text-center font-mono text-[11px] text-[var(--color-text-faint)]" style="animation-delay:0.2s" set:html={t.builtBy} />
      </div>
    </section>

    {/* ─── Manifesto — a quiet philosophical sign-off before the footer */}
    <section class="relative isolate overflow-hidden py-32 sm:py-44">
      <div
        class="pointer-events-none absolute inset-0 -z-10"
        style="background-image:url('/manifesto-bg.webp'); background-size:cover; background-position:center; mask-image:linear-gradient(180deg, transparent 0%, black 18%, black 82%, transparent 100%); -webkit-mask-image:linear-gradient(180deg, transparent 0%, black 18%, black 82%, transparent 100%);"
      ></div>

      <div class="mx-auto max-w-4xl px-6 text-center">
        <p class="type-manifesto reveal mx-auto text-[var(--color-text)]">
          {/* A couplet — break exactly on the sentence boundary. */}
          <span class="sm:block">{t.manifesto[0]}</span>
          <span class="sm:block">{t.manifesto[1]}</span>
        </p>
      </div>
    </section>
  </main>

  {/* ─── Footer — wordmark + tagline + structured links */}
  <footer class="relative border-t border-[var(--color-border)]/60 py-20 sm:py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid grid-cols-1 gap-14 sm:grid-cols-12 sm:gap-10">
        {/* Wordmark column */}
        <div class="sm:col-span-6">
          <a
            href={lang === 'zh' ? '/' : '/en/'}
            class="inline-flex items-baseline gap-3 text-[var(--color-text)]"
          >
            <img src="/logo-256.png" alt="" width="56" height="56" class="size-12 self-center sm:size-14" />
            <span class="type-wordmark" style="font-size:clamp(3rem,5vw,4.25rem);font-weight:380">
              Hive
            </span>
          </a>
          <p class="mt-5 max-w-sm text-[15px] leading-relaxed text-[var(--color-text-muted)]">
            {t.footerTagline}
          </p>
        </div>

        {/* Link columns */}
        <div class="grid grid-cols-2 gap-10 sm:col-span-6">
          <div>
            <p class="type-kicker text-[var(--color-text-faint)]">{t.footerColProduct}</p>
            <ul class="mt-5 space-y-3 text-[14px]">
              <li><a href="https://github.com/tt-a1i/hive" class="text-[var(--color-text-muted)] transition-colors duration-150 ease-out hover:text-[var(--color-text)]">GitHub</a></li>
              <li><a href="https://www.npmjs.com/package/@tt-a1i/hive" class="text-[var(--color-text-muted)] transition-colors duration-150 ease-out hover:text-[var(--color-text)]">npm</a></li>
              <li><a href="https://github.com/tt-a1i/hive/blob/main/CHANGELOG.md" class="text-[var(--color-text-muted)] transition-colors duration-150 ease-out hover:text-[var(--color-text)]">{t.footerLinkChangelog}</a></li>
            </ul>
          </div>
          <div>
            <p class="type-kicker text-[var(--color-text-faint)]">{t.footerColAbout}</p>
            <ul class="mt-5 space-y-3 text-[14px]">
              <li><a href="https://github.com/tt-a1i/hive/blob/main/LICENSE.BSL" class="text-[var(--color-text-muted)] transition-colors duration-150 ease-out hover:text-[var(--color-text)]">{t.footerLinkLicense}</a></li>
              <li><a href="https://github.com/tt-a1i/hive/blob/main/SECURITY.md" class="text-[var(--color-text-muted)] transition-colors duration-150 ease-out hover:text-[var(--color-text)]">{t.footerLinkSecurity}</a></li>
              <li><a href="https://github.com/tt-a1i/hive/issues" class="text-[var(--color-text-muted)] transition-colors duration-150 ease-out hover:text-[var(--color-text)]">{t.footerLinkIssues}</a></li>
            </ul>
          </div>
        </div>
      </div>

      {/* Bottom row */}
      <div class="mt-16 flex flex-col gap-3 border-t border-[var(--color-border)]/50 pt-8 sm:flex-row sm:items-center sm:justify-between">
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-text-faint)]">{t.footerNote}</p>
        <p class="font-mono text-[11px] tracking-[0.04em] text-[var(--color-text-faint)]" set:html={t.builtBy} />
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Video facade: load the third-party player only when asked.
  for (const facade of document.querySelectorAll<HTMLElement>('[data-video-facade]')) {
    facade.querySelector('[data-video-play]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe')
      iframe.src = facade.dataset.src ?? ''
      iframe.title = facade.dataset.title ?? ''
      iframe.allowFullscreen = true
      iframe.setAttribute('allow', 'autoplay; fullscreen')
      iframe.setAttribute('referrerpolicy', 'no-referrer')
      iframe.className = 'absolute inset-0 size-full border-0'
      facade.replaceChildren(iframe)
    })
  }

  // Click-to-copy for the install commands (hero button + install card).
  for (const copyBtn of document.querySelectorAll<HTMLButtonElement>('[data-copy-text]')) copyBtn.addEventListener('click', async () => {
    const text = copyBtn.dataset.copyText ?? ''
    let copied = false
    try {
      await navigator.clipboard.writeText(text)
      copied = true
    } catch {
      // Fallback for contexts where the async clipboard API is unavailable.
      const ta = document.createElement('textarea')
      ta.value = text
      ta.style.position = 'fixed'
      ta.style.opacity = '0'
      document.body.appendChild(ta)
      ta.select()
      copied = document.execCommand('copy')
      ta.remove()
    }
    const label = copyBtn.querySelector('[data-copy-label]')
    if (copied && label) {
      const original = label.textContent
      label.textContent = copyBtn.dataset.copiedLabel ?? 'Copied'
      setTimeout(() => {
        label.textContent = original
      }, 1600)
    }
  })
</script>
