---
import { getImage } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import Nav from './Nav.astro'
import Hero from './Hero.astro'
import SectionHeading from './SectionHeading.astro'
import PatternsGallery from './PatternsGallery.astro'
import FeatureGrid from './FeatureGrid.astro'
import RemoteBand from './RemoteBand.astro'
import CliGrid from './CliGrid.astro'
import Swarm from './Swarm.astro'
import hiveUi from '../assets/screenshots/hive-ui.png'
import hiveUiMobile from '../assets/screenshots/hive-ui-mobile.png'
import type { Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props

/* Build-time fetch — npm registry + downloads. If a fetch fails we omit the
   line entirely rather than advertise a stale hardcoded version. */
const fetchJson = async (url: string) => {
  try {
    const r = await fetch(url, {
      headers: { accept: 'application/json' },
      signal: AbortSignal.timeout(5000),
    })
    if (!r.ok) return null
    return await r.json()
  } catch {
    return null
  }
}

const npmPkg = await fetchJson('https://registry.npmjs.org/@tt-a1i/hive')
const npmLatest =
  (npmPkg && (npmPkg['dist-tags'] as Record<string, string> | undefined)?.latest) ?? null
const npmTimes = (npmPkg && (npmPkg.time as Record<string, string> | undefined)) ?? null
const npmPublishedISO = (npmLatest && npmTimes?.[npmLatest]) ?? null
/* Absolute date — a relative "published yesterday" fossilizes in static HTML. */
const npmPublishedDate = npmPublishedISO ? npmPublishedISO.slice(0, 10) : null

const dlData = await fetchJson('https://api.npmjs.org/downloads/point/last-week/@tt-a1i/hive')
const weeklyDownloads = (dlData?.downloads as number | undefined) ?? null

/* Art-directed screenshot: phones get a readable crop of the team panel.
   Manual <picture> so mobile never downloads the desktop file. */
const SHOT_WIDTHS = [768, 1280, 1920, 2400]
const shotDesktopAvif = await getImage({ src: hiveUi, format: 'avif', widths: SHOT_WIDTHS })
const shotDesktopWebp = await getImage({ src: hiveUi, format: 'webp', widths: SHOT_WIDTHS })
const shotMobileAvif = await getImage({ src: hiveUiMobile, format: 'avif', widths: [480, 720, 1120] })
const shotMobileWebp = await getImage({ src: hiveUiMobile, format: 'webp', widths: [480, 720, 1120] })
const shotFallback = await getImage({ src: hiveUi, format: 'webp', width: 1920 })
const shotSizesDesktop = '(min-width: 1320px) 1272px, 92vw'
const shotSizesMobile = '92vw'

const MANIFESTO_SPAWN = 1900

const link = 'underline-offset-2 transition-colors hover:text-[var(--color-text)] hover:underline'
const t = lang === 'zh'
  ? {
      shotAlt:
        'Hive 工作台：浏览器里的 orchestrator 给多个 CLI worker（Claude Code、Codex、Gemini 等）派活的协作截图',
      steps: ['你给 Orchestrator 一个目标', '它用 team send 给 Worker 派活', 'Worker 干完，team report 交回'],
      play: '看 7 分钟实录',
      videoTitle: 'Hive 演示视频',
      videoMeta: '07:21 · 一镜到底 · Bilibili',
      close: '关闭',
      openOnBili: '在 Bilibili 打开',
      install: {
        kicker: '安装',
        heading: '两条命令，造一座蜂巢。',
        copy: '复制',
        copied: '已复制',
        openHint: '# 打开它打印的本机地址，通常是 http://127.0.0.1:3000',
        published: (d: string) => `发布于 ${d}`,
        downloads: (n: string) => `周下载 ${n}`,
        demo: '还没装任何 Agent CLI？启动后在向导里点 <strong>Try Demo</strong>——先看一个假蜂巢跑起来，再决定装不装真的。',
        trust: '只监听 127.0.0.1 · 代码不出本机 · BSL 1.1 · Node ≥ 22 · macOS / Linux / Windows',
      },
      manifesto: ['一个 Agent，等你的下一条指令。', '一座蜂巢，朝你给的方向飞。'],
      footerNote: 'Hive · 2026',
      builtBy: `由 <a href="https://github.com/tt-a1i" target="_blank" rel="noopener" class="${link}">@tt-a1i</a> 一人维护 · Node ≥ 22`,
      footerTagline: '一座属于你的 Agent 蜂巢。本地运行，源码可见。',
      footerColProduct: '产品',
      footerColAbout: '项目',
      footerLinkChangelog: '更新日志',
      footerLinkLicense: '许可证 · BSL 1.1',
      footerLinkSecurity: '安全',
      footerLinkIssues: '反馈',
    }
  : {
      shotAlt:
        'Hive workbench: an orchestrator dispatching tasks to Claude Code, Codex and Gemini worker terminals in the browser',
      steps: ['You give the orchestrator a goal', 'It dispatches workers via team send', 'Workers finish and team report back'],
      play: 'Watch the 7-minute take',
      videoTitle: 'Hive demo video',
      videoMeta: '07:21 · one take · Bilibili · Chinese narration',
      close: 'Close',
      openOnBili: 'Open on Bilibili',
      install: {
        kicker: 'Install',
        heading: 'Two commands to a hive.',
        copy: 'Copy',
        copied: 'Copied',
        openHint: '# open the URL it prints — usually http://127.0.0.1:3000',
        published: (d: string) => `published ${d}`,
        downloads: (n: string) => `${n} weekly downloads`,
        demo: 'No agent CLIs installed yet? Hit <strong>Try Demo</strong> in the first-run wizard — watch a fake hive run before you install a real one.',
        trust: 'Binds to 127.0.0.1 · your code stays home · BSL 1.1 · Node ≥ 22 · macOS / Linux / Windows',
      },
      manifesto: ['One agent waits for your next word.', 'A hive flies where you point.'],
      footerNote: 'Hive · 2026',
      builtBy: `Solo-built by <a href="https://github.com/tt-a1i" target="_blank" rel="noopener" class="${link}">@tt-a1i</a> · Node ≥ 22`,
      footerTagline: 'A hive of agents, on your laptop. Local, source-available.',
      footerColProduct: 'Product',
      footerColAbout: 'Project',
      footerLinkChangelog: 'Changelog',
      footerLinkLicense: 'License · BSL 1.1',
      footerLinkSecurity: 'Security',
      footerLinkIssues: 'Issues',
    }

const videoSrc =
  'https://player.bilibili.com/player.html?bvid=BV1UHLp6nEQR&page=1&as_wide=1&high_quality=1&danmaku=0&autoplay=1'
const footerLinks = [
  { title: t.footerColProduct, links: [
    { label: 'GitHub', href: 'https://github.com/tt-a1i/hive' },
    { label: 'npm', href: 'https://www.npmjs.com/package/@tt-a1i/hive' },
    { label: t.footerLinkChangelog, href: 'https://github.com/tt-a1i/hive/blob/main/CHANGELOG.md' },
  ] },
  { title: t.footerColAbout, links: [
    { label: t.footerLinkLicense, href: 'https://github.com/tt-a1i/hive/blob/main/LICENSE.BSL' },
    { label: t.footerLinkSecurity, href: 'https://github.com/tt-a1i/hive/blob/main/SECURITY.md' },
    { label: t.footerLinkIssues, href: 'https://github.com/tt-a1i/hive/issues' },
  ] },
]
---

<Layout lang={lang} npmVersion={npmLatest}>
  <Nav lang={lang} />

  <main>
    <Hero lang={lang} />

    {/* ─── The real product. Tilts flat as it scrolls into view; the demo
        video opens from it in a dialog instead of taking its own section. ─ */}
    <section class="relative isolate pb-16 sm:pb-24">
      <div class="mx-auto max-w-[1320px] px-6">
        <div class="rise-in relative">
          <div class="overflow-hidden rounded-2xl border border-[var(--color-border)] shadow-[0_40px_90px_-36px_rgba(15,23,42,0.35)]">
            <picture>
              <source media="(max-width: 639px)" type="image/avif" srcset={shotMobileAvif.srcSet.attribute} sizes={shotSizesMobile} />
              <source media="(max-width: 639px)" type="image/webp" srcset={shotMobileWebp.srcSet.attribute} sizes={shotSizesMobile} />
              <source type="image/avif" srcset={shotDesktopAvif.srcSet.attribute} sizes={shotSizesDesktop} />
              <source type="image/webp" srcset={shotDesktopWebp.srcSet.attribute} sizes={shotSizesDesktop} />
              <img
                src={shotFallback.src}
                width={hiveUi.width}
                height={hiveUi.height}
                alt={t.shotAlt}
                loading="eager"
                decoding="async"
                fetchpriority="high"
                class="block w-full"
              />
            </picture>
          </div>
          <button
            type="button"
            data-video-open
            class="group absolute bottom-4 left-4 inline-flex cursor-pointer items-center gap-3 rounded-full bg-white/90 py-2 pl-2 pr-5 text-[13.5px] font-semibold text-[var(--color-text)] shadow-[0_14px_36px_-12px_rgba(11,30,62,0.45)] ring-1 ring-black/5 backdrop-blur-md transition-all duration-200 ease-out hover:-translate-y-0.5 hover:bg-white sm:bottom-7 sm:left-7"
          >
            <span class="flex size-9 items-center justify-center rounded-full bg-[var(--color-accent)] text-white transition-transform duration-200 group-hover:scale-105">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 5.5v13l11-6.5z"/></svg>
            </span>
            {t.play}
            <span class="hidden font-mono text-[11px] font-normal text-[var(--color-text-faint)] sm:inline">07:21</span>
          </button>
        </div>

        <ol class="mx-auto mt-9 flex max-w-4xl flex-col gap-2.5 px-1 font-mono text-[12px] leading-relaxed text-[var(--color-text-muted)] sm:flex-row sm:justify-between sm:gap-8">
          {t.steps.map((step, i) => (
            <li class="flex items-baseline gap-2.5">
              <span class="text-[var(--color-accent)]">0{i + 1}</span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <PatternsGallery lang={lang} />
    <FeatureGrid lang={lang} />
    <CliGrid lang={lang} />
    <RemoteBand lang={lang} />

    {/* ─── Install ─────────────────────────────────────────────── */}
    <section id="install" class="relative isolate py-24 sm:py-32">
      <div
        class="pointer-events-none absolute inset-0 -z-10 opacity-[0.07]"
        style="background-image:url('/hero-bg.webp'); background-size:cover; background-position:50% 60%; mask-image:radial-gradient(ellipse 80% 70% at 50% 50%, black, transparent 75%); -webkit-mask-image:radial-gradient(ellipse 80% 70% at 50% 50%, black, transparent 75%);"
      ></div>
      <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 size-[900px] -translate-x-1/2 -translate-y-1/2 rounded-full blur-[120px]" style="background: radial-gradient(circle, var(--color-warm-soft), transparent 60%);"></div>

      <div class="mx-auto max-w-3xl px-6">
        <SectionHeading kicker={t.install.kicker} heading={t.install.heading} class="reveal" />

        <div class="reveal mt-10 rounded-3xl border border-[var(--color-border)] bg-white p-8 shadow-[0_20px_60px_-20px_rgba(15,23,42,0.12)] sm:p-10" style="animation-delay:0.1s">
          <div class="relative rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-2)] p-5 font-mono text-[13px] leading-[1.95]">
            <button
              type="button"
              class="absolute right-3 top-3 inline-flex cursor-pointer items-center gap-1.5 rounded-md border border-[var(--color-border)] bg-white px-2.5 py-1.5 font-mono text-[11px] text-[var(--color-text-muted)] transition-colors duration-150 ease-out hover:border-[var(--color-accent)]/40 hover:text-[var(--color-text)]"
              data-copy-install
              data-copied-label={t.install.copied}
            >
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                <rect x="9" y="9" width="11" height="11" rx="2"/>
                <path d="M5 15V5a2 2 0 0 1 2-2h10"/>
              </svg>
              <span>{t.install.copy}</span>
            </button>
            <div><span class="select-none text-[var(--color-accent)]">$</span> <span class="text-[var(--color-text)]">npm i -g @tt-a1i/hive</span></div>
            <div><span class="select-none text-[var(--color-accent)]">$</span> <span class="text-[var(--color-text)]">hive</span></div>
            <div class="text-[var(--color-text-faint)]">{t.install.openHint}</div>
          </div>

          {(npmLatest || weeklyDownloads !== null) && (
            <p class="mt-5 font-mono text-[11px] tracking-[0.06em] text-[var(--color-text-faint)]">
              {npmLatest && <span class="text-[var(--color-text-muted)]">v{npmLatest}</span>}
              {npmPublishedDate && <><span class="mx-2 opacity-50">·</span>{t.install.published(npmPublishedDate)}</>}
              {weeklyDownloads !== null && <><span class="mx-2 opacity-50">·</span>{t.install.downloads(weeklyDownloads.toLocaleString('en-US'))}</>}
            </p>
          )}

          <p class="mt-5 text-[13.5px] leading-relaxed text-[var(--color-text-muted)] [&_strong]:font-semibold [&_strong]:text-[var(--color-text)]" set:html={t.install.demo} />

          <p class="mt-6 border-t border-[var(--color-border)]/70 pt-5 font-mono text-[11px] leading-relaxed text-[var(--color-text-faint)]">
            {t.install.trust}
          </p>
        </div>
      </div>
    </section>

    {/* ─── Manifesto — the closing bookend of the hero: one waits, many fly. */}
    <section class="manifesto relative isolate overflow-hidden py-36 sm:py-48">
      <div
        class="pointer-events-none absolute inset-0 -z-10"
        style="background-image:url('/manifesto-bg.webp'); background-size:cover; background-position:center; mask-image:linear-gradient(180deg, transparent 0%, black 18%, black 82%, transparent 100%); -webkit-mask-image:linear-gradient(180deg, transparent 0%, black 18%, black 82%, transparent 100%);"
      ></div>
      <Swarm mode="wait" spawn={MANIFESTO_SPAWN} class="-z-5" />

      <div class="mx-auto max-w-4xl px-6 text-center">
        <p class="type-manifesto mx-auto text-[var(--color-text)]">
          <span class="m-line inline-block" data-swarm-origin>{t.manifesto[0]}</span>
          <br class="hidden sm:block" />
          <span class="m-line inline-block" style={`transition-delay:${MANIFESTO_SPAWN}ms`}>{t.manifesto[1]}</span>
        </p>
      </div>
    </section>
  </main>

  <footer class="relative border-t border-[var(--color-border)]/60 py-20 sm:py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid grid-cols-1 gap-14 sm:grid-cols-12 sm:gap-10">
        <div class="sm:col-span-6">
          <a href={lang === 'zh' ? '/' : '/en/'} class="inline-flex items-baseline gap-3 text-[var(--color-text)]">
            <img src="/logo-256.png" alt="" width="56" height="56" class="size-12 self-center sm:size-14" />
            <span class="type-wordmark" style="font-size:clamp(3rem,5vw,4.25rem);font-weight:380">Hive</span>
          </a>
          <p class="mt-5 max-w-sm text-[15px] leading-relaxed text-[var(--color-text-muted)]">{t.footerTagline}</p>
        </div>

        <div class="grid grid-cols-2 gap-10 sm:col-span-6">
          {footerLinks.map((col) => (
            <div>
              <p class="type-kicker text-[var(--color-text-faint)]">{col.title}</p>
              <ul class="mt-5 space-y-3 text-[14px]">
                {col.links.map((l) => (
                  <li><a href={l.href} class="text-[var(--color-text-muted)] transition-colors duration-150 ease-out hover:text-[var(--color-text)]">{l.label}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-16 flex flex-col gap-3 border-t border-[var(--color-border)]/50 pt-8 sm:flex-row sm:items-center sm:justify-between">
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-text-faint)]">{t.footerNote}</p>
        <p class="font-mono text-[11px] tracking-[0.04em] text-[var(--color-text-faint)]" set:html={t.builtBy} />
      </div>
    </div>
  </footer>

  <dialog data-video-dialog aria-label={t.videoTitle} class="video-dialog m-auto w-[min(94vw,1120px)] overflow-visible bg-transparent p-0">
    <div class="overflow-hidden rounded-2xl bg-[#0e1117] shadow-[0_40px_120px_-30px_rgba(0,0,0,0.6)]">
      <div class="flex items-center justify-between gap-4 px-4 py-2.5 font-mono text-[11px] text-white/55 sm:px-5">
        <span class="truncate">{t.videoMeta}</span>
        <span class="flex shrink-0 items-center gap-4">
          <a href="https://www.bilibili.com/video/BV1UHLp6nEQR" target="_blank" rel="noopener" class="transition-colors hover:text-white">{t.openOnBili} ↗</a>
          <button type="button" data-video-close class="cursor-pointer rounded-md px-2 py-1 text-white/80 transition-colors hover:bg-white/10 hover:text-white">{t.close} ✕</button>
        </span>
      </div>
      <div class="relative bg-black" style="aspect-ratio:16/9" data-video-slot data-src={videoSrc} data-title={t.videoTitle}></div>
    </div>
  </dialog>
</Layout>

<style>
  /* Manifesto lines wait for the section to come into view (JS arms them,
     so without JS or with reduced motion they are simply there). */
  .manifesto:global(.swarm-armed) .m-line {
    opacity: 0;
    transform: translateY(12px);
    filter: blur(6px);
    transition: opacity 0.9s ease, transform 0.9s cubic-bezier(0.16, 0.84, 0.24, 1), filter 0.9s ease;
  }
  .manifesto:global(.swarm-armed.is-in) .m-line {
    opacity: 1;
    transform: none;
    filter: none;
  }

  .video-dialog::backdrop {
    background: rgba(11, 30, 62, 0.42);
    backdrop-filter: blur(10px);
  }
  /* Motion only, never opacity: if the animation stalls the player is still visible. */
  .video-dialog[open] { animation: dialog-in 0.32s cubic-bezier(0.16, 0.84, 0.24, 1); }
  @keyframes dialog-in {
    from { transform: translateY(14px) scale(0.98); }
  }
</style>

<script>
  /* Demo video: a dialog over the page; the player loads only when opened
     and is torn down on close so playback stops. */
  const dialog = document.querySelector<HTMLDialogElement>('[data-video-dialog]')
  const slot = dialog?.querySelector<HTMLElement>('[data-video-slot]')
  if (dialog && slot) {
    document.querySelector('[data-video-open]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe')
      iframe.src = slot.dataset.src ?? ''
      iframe.title = slot.dataset.title ?? ''
      iframe.allowFullscreen = true
      iframe.setAttribute('allow', 'autoplay; fullscreen')
      iframe.setAttribute('referrerpolicy', 'no-referrer')
      iframe.className = 'absolute inset-0 size-full border-0'
      slot.replaceChildren(iframe)
      dialog.showModal()
    })
    dialog.querySelector('[data-video-close]')?.addEventListener('click', () => dialog.close())
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close() })
    dialog.addEventListener('close', () => slot.replaceChildren())
  }

  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy-install]')
  copyBtn?.addEventListener('click', async () => {
    const text = 'npm i -g @tt-a1i/hive\nhive'
    let copied = false
    try {
      await navigator.clipboard.writeText(text)
      copied = true
    } catch {
      const ta = document.createElement('textarea')
      ta.value = text
      ta.style.position = 'fixed'
      ta.style.opacity = '0'
      document.body.appendChild(ta)
      ta.select()
      copied = document.execCommand('copy')
      ta.remove()
    }
    const label = copyBtn.querySelector('span')
    if (!copied || !label) return
    const original = label.textContent
    label.textContent = copyBtn.dataset.copiedLabel ?? 'Copied'
    setTimeout(() => { label.textContent = original }, 1600)
  })
</script>
